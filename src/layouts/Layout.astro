---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Southeastern Reptile Conservation — Wildlife rehabilitation and conservation in Virginia.', image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <title>{title} — SERC</title>
    <link rel="icon" type="image/png" href="/images/serc-logo.png" />
  </head>
  <body>

    <header class="nav">
      <div class="nav__inner">
        <a href="/" class="nav__logo">
          <img src="/images/serc-logo.png" alt="SERC logo" />
        </a>
        <nav>
          <ul class="nav__links">
            <li><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a></li>
            <li><a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a></li>
            <li><a href="/wildlife" aria-current={Astro.url.pathname === '/wildlife' ? 'page' : undefined}>Wildlife</a></li>
            <li><a href="/open-source" aria-current={Astro.url.pathname.startsWith('/open-source') ? 'page' : undefined}>Software</a></li>
            <li><a href="/blog" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a></li>
            <li><a href="/contact" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contact</a></li>
            <li><a href="/merch" aria-current={Astro.url.pathname === '/merch' ? 'page' : undefined}>Merch</a></li>
          </ul>
        </nav>
        <div class="nav__actions">
          <a href="https://www.instagram.com/purringturtle" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://linktr.ee/turtlerehab" target="_blank" rel="noopener" class="btn btn--dark">Donate</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <div>
          <div class="footer__name">Southeastern Reptile Conservation (SERC)</div>
          <p class="footer__tagline">
            Protecting native reptiles and amphibians through rehabilitation,<br />
            habitat stewardship, and community education. Norfolk, Virginia.
          </p>
        </div>
        <div class="footer__contact">
          <strong>Contact</strong><br />
          <a href="mailto:info@southeastreptile.org">info@southeastreptile.org</a>
        </div>
      </div>
      <div class="footer__bottom">
        <span>&copy; {new Date().getFullYear()} Southeastern Reptile Conservation. All rights reserved.</span>
        <span>501(c)(3) Nonprofit &nbsp;&middot;&nbsp; EIN 39-4578100</span>
      </div>
    </footer>

  </body>
</html>
