---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = 'Southeastern Reptile Conservation — Wildlife rehabilitation and conservation in Virginia.',
  image,
  type = 'website',
  schema,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : new URL('/images/serc-logo.png', Astro.site).toString();

// Append the brand suffix only when the page title doesn't already include it.
const fullTitle = /serc/i.test(title) ? title : `${title} | SERC`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <!-- Local SEO -->
    <meta name="geo.region" content="US-VA" />
    <meta name="geo.placename" content="Hampton Roads, Virginia" />
    <!-- Preconnect to Google Fonts for faster loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Marcellus&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap" /></noscript>
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Southeastern Reptile Conservation" />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- JSON-LD -->
    {schema && (Array.isArray(schema)
      ? schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    <title>{fullTitle}</title>
    <link rel="icon" type="image/png" href="/images/serc-logo.png" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N186ZPKTJC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N186ZPKTJC');
    </script>
  </head>
  <body>

    <header class="nav" id="site-nav">
      <div class="nav__inner">
        <a href="/" class="nav__logo">
          <img src="/images/serc-logo.png" alt="SERC logo" />
        </a>
        <nav>
          <ul class="nav__links">
            <li><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a></li>
            <li><a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a></li>
            <li><a href="/wildlife" aria-current={Astro.url.pathname === '/wildlife' ? 'page' : undefined}>Our patients</a></li>
            <li class="nav__has-dropdown">
              <a href="/species" class="nav__dropdown-toggle" aria-current={(Astro.url.pathname.startsWith('/species') || Astro.url.pathname.startsWith('/turtle-watch')) ? 'page' : undefined}>
                Field guide <span class="nav__caret">▾</span>
              </a>
              <ul class="nav__dropdown">
                <li><a href="/species" aria-current={Astro.url.pathname.startsWith('/species') ? 'page' : undefined}>Species ID</a></li>
                <li><a href="/turtle-watch" aria-current={Astro.url.pathname.startsWith('/turtle-watch') ? 'page' : undefined}>Turtle Watch</a></li>
              </ul>
            </li>
            <li><a href="/open-source" aria-current={Astro.url.pathname.startsWith('/open-source') ? 'page' : undefined}>Software</a></li>
            <li><a href="/blog" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a></li>
            <li><a href="/rehabber-resources" aria-current={Astro.url.pathname.startsWith('/rehabber-resources') ? 'page' : undefined}>Rehabbers</a></li>
            <li><a href="/contact" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contact</a></li>
          </ul>
        </nav>
        <div class="nav__actions">
          <a href="https://www.inaturalist.org/people/southeastreptile" target="_blank" rel="noopener" aria-label="iNaturalist">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C9 2 4 6 4 12c0 4 2.5 7.5 6 9"/>
              <path d="M12 2c3 0 8 4 8 10 0 4-2.5 7.5-6 9"/>
              <path d="M12 2v20"/>
              <path d="M4 12h16"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/purringturtle" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </a>
          <div class="nav__has-dropdown">
            <a href="/donate" class="btn btn--dark nav__support-btn">Support <span class="nav__caret nav__caret--btn">▾</span></a>
            <ul class="nav__dropdown nav__dropdown--right">
              <li><a href="/donate">Donate</a></li>
              <li><a href="/merch">Merch</a></li>
            </ul>
          </div>
          <button class="nav__hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div class="nav__mobile" id="nav-mobile" aria-hidden="true">
        <ul class="nav__mobile-links">
          <li><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a></li>
          <li><a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a></li>
          <li><a href="/wildlife" aria-current={Astro.url.pathname === '/wildlife' ? 'page' : undefined}>Our patients</a></li>
          <li class="nav__mobile-group-label">Field guide</li>
          <li class="nav__mobile-sub"><a href="/species" aria-current={Astro.url.pathname.startsWith('/species') ? 'page' : undefined}>Species ID</a></li>
          <li class="nav__mobile-sub"><a href="/turtle-watch" aria-current={Astro.url.pathname.startsWith('/turtle-watch') ? 'page' : undefined}>Turtle Watch</a></li>
          <li><a href="/open-source" aria-current={Astro.url.pathname.startsWith('/open-source') ? 'page' : undefined}>Software</a></li>
          <li><a href="/blog" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a></li>
          <li><a href="/rehabber-resources" aria-current={Astro.url.pathname.startsWith('/rehabber-resources') ? 'page' : undefined}>Rehabbers</a></li>
          <li><a href="/contact" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contact</a></li>
          <li class="nav__mobile-group-label">Support</li>
          <li class="nav__mobile-sub"><a href="/donate">Donate</a></li>
          <li class="nav__mobile-sub"><a href="/merch" aria-current={Astro.url.pathname === '/merch' ? 'page' : undefined}>Merch</a></li>
        </ul>
        <div class="nav__mobile-footer">
          <a href="https://www.inaturalist.org/people/southeastreptile" target="_blank" rel="noopener" aria-label="iNaturalist" style="color: var(--color-text-muted);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C9 2 4 6 4 12c0 4 2.5 7.5 6 9"/>
              <path d="M12 2c3 0 8 4 8 10 0 4-2.5 7.5-6 9"/>
              <path d="M12 2v20"/>
              <path d="M4 12h16"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/purringturtle" target="_blank" rel="noopener" aria-label="Instagram" style="color: var(--color-text-muted);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
            </svg>
          </a>
          <a href="/donate" class="btn btn--dark">Donate</a>
        </div>
      </div>
    </header>

    <script is:inline>
      (function () {
        var btn    = document.getElementById('nav-hamburger');
        var nav    = document.getElementById('site-nav');
        var menu   = document.getElementById('nav-mobile');
        var links  = menu.querySelectorAll('a');

        function open() {
          nav.classList.add('nav--open');
          btn.setAttribute('aria-expanded', 'true');
          menu.setAttribute('aria-hidden', 'false');
        }
        function close() {
          nav.classList.remove('nav--open');
          btn.setAttribute('aria-expanded', 'false');
          menu.setAttribute('aria-hidden', 'true');
        }

        btn.addEventListener('click', function () {
          nav.classList.contains('nav--open') ? close() : open();
        });

        links.forEach(function (link) {
          link.addEventListener('click', close);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
      })();
    </script>

    <!-- GA4 key-event tracking -->
    <script is:inline>
      (function () {
        function track(name, params) {
          if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
        }
        document.addEventListener('click', function (e) {
          var a = e.target.closest ? e.target.closest('a') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (href.indexOf('sms:') === 0) {
            track('text_click', { link_url: href });
          } else if (href.indexOf('mailto:') === 0) {
            track('email_click', { link_url: href });
          } else if (href === '/donate' || /zeffy|paypal|bonfire/i.test(href)) {
            track('donate_click', { link_url: href });
          } else if (/amazon|chewy|walmart/i.test(href)) {
            track('wishlist_click', { link_url: href });
          }
        }, true);
        var form = document.querySelector('form[name="contact"]');
        if (form) {
          form.addEventListener('submit', function () {
            track('contact_submit');
          });
        }
      })();
    </script>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <div>
          <div class="footer__name">Southeastern Reptile Conservation (SERC)</div>
          <p class="footer__tagline">
            Protecting native reptiles and amphibians through rehabilitation,<br />
            habitat stewardship, and community education.
          </p>
          <p class="footer__tagline" style="margin-top: 0.75rem;">
            Licensed wildlife rehabilitation serving Hampton Roads<br />
            and Southeastern Virginia.
          </p>
        </div>
        <div class="footer__contact">
          <strong>Contact</strong><br />
          <a href="mailto:info@southeastreptile.org">info@southeastreptile.org</a><br />
          <a href="/rehabber-resources" style="font-size: 13px; color: var(--color-text-faint);">Rehabber resources</a>
        </div>
      </div>
      <div class="footer__bottom">
        <span>&copy; {new Date().getFullYear()} Southeastern Reptile Conservation. All rights reserved.</span>
        <span style="display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
          <span>501(c)(3) Nonprofit &nbsp;&middot;&nbsp; EIN 39-4578100</span>
          <span style="display: flex; gap: 1rem; align-items: center;">
            <a href="https://www.inaturalist.org/people/southeastreptile" target="_blank" rel="noopener" aria-label="iNaturalist" style="opacity: 0.5; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.5'">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2C9 2 4 6 4 12c0 4 2.5 7.5 6 9"/>
                <path d="M12 2c3 0 8 4 8 10 0 4-2.5 7.5-6 9"/>
                <path d="M12 2v20"/>
                <path d="M4 12h16"/>
              </svg>
            </a>
            <a href="https://www.instagram.com/purringturtle" target="_blank" rel="noopener" aria-label="Instagram" style="opacity: 0.5; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.5'">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
              </svg>
            </a>
          </span>
        </span>
      </div>
    </footer>

  </body>
</html>
