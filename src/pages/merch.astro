---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    name: 'Help save injured turtles!',
    price: '$30',
    styles: '8 styles',
    url: 'https://www.bonfire.com/help-save-injured-turtles/',
    image: 'https://dynamic.bonfireassets.com/thumb/design-image/0d782fda-7508-4790-b681-8c4eb7fb6235/a12f1364-34a5-4ab3-bcd5-fb45910a2e8f/450/',
  },
  {
    name: 'All you need is love... and turtles!',
    price: '$32',
    styles: '9 styles',
    url: 'https://www.bonfire.com/all-you-need-is-love-and-turtles/',
    image: 'https://dynamic.bonfireassets.com/thumb/design-image/8f2e3235-4e57-402f-9f79-046445ae3196/a12f1364-34a5-4ab3-bcd5-fb45910a2e8f/450/',
  },
  {
    name: 'Wear a snake on your heart!',
    price: '$28',
    styles: '7 styles',
    url: 'https://www.bonfire.com/save-native-snakes/',
    image: 'https://dynamic.bonfireassets.com/thumb/design-image/68e3a592-b0ff-4ad1-b4ca-e474eee6f7e6/a12f1364-34a5-4ab3-bcd5-fb45910a2e8f/450/',
  },
  {
    name: 'Meet the toads at midnight!',
    price: '$28',
    styles: '7 styles',
    url: 'https://www.bonfire.com/save-the-toads/',
    image: 'https://c.bonfireassets.com/thumb/design-image/4873981f-4b02-452a-8ced-be98bcd6ed75/e9c2cd77-4ea2-4179-a32e-3b0e6282c053/900/',
  },
  {
    name: 'Help support the baby turtles!',
    price: '$28',
    styles: '8 styles',
    url: 'https://www.bonfire.com/support-baby-turtles/',
    image: 'https://c.bonfireassets.com/thumb/design-image/cc8a528d-27bd-4891-8f9f-845140ae3b60/fefea009-962d-403a-b60d-f799fa6bf49a/900/',
  },
  {
    name: 'Help support the baby turtles! (hoodie)',
    price: '$45',
    styles: '6 styles',
    url: 'https://www.bonfire.com/support-baby-turtles-winter/',
    image: 'https://c.bonfireassets.com/thumb/design-image/8edbea98-f4d6-4f12-b245-aaaeb23e3ea1/b8c0e7b9-ed44-45dd-9b16-c5122ab0d815/900/',
  },
  {
    name: 'Turtle Totes to support rehab!',
    price: '$25',
    styles: '4 styles',
    url: 'https://www.bonfire.com/turtle-totes-for-rehab-1/',
    image: 'https://c.bonfireassets.com/thumb/design-image/5dc0b10b-8530-4190-aeba-6ad30e252847/4a517a59-f7fe-43fa-bab5-e3b87f25424f/900/',
  },
];
---

<Layout
  title="SERC Merch | Support Virginia Reptile & Amphibian Rescue"
  description="Shop SERC merchandise on Bonfire. Every purchase directly supports the rehabilitation of injured and displaced native reptiles and amphibians in Virginia."
>

  <!-- Header -->
  <section style="padding: 5rem var(--site-gutter) 3rem; max-width: var(--site-max); margin: 0 auto; border-bottom: 1px solid var(--color-border);">
    <h1 style="margin-bottom: 1rem;">Shop merch</h1>
    <p style="max-width: 560px; color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.8;">
      Every purchase directly supports the rehabilitation of injured and displaced native
      reptiles and amphibians. All items are printed and fulfilled by Bonfire.
    </p>
  </section>

  <!-- Product grid -->
  <section style="padding: 4rem var(--site-gutter); max-width: var(--site-max); margin: 0 auto;">
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      {products.map(product => (
        <a
          href={product.url}
          target="_blank"
          rel="noopener noreferrer"
          style="display: block; background: var(--color-surface); border: 1px solid var(--color-border); text-decoration: none; color: inherit; transition: border-color 0.2s;"
          onmouseover="this.style.borderColor='var(--color-accent)'"
          onmouseout="this.style.borderColor='var(--color-border)'"
        >
          <div style="aspect-ratio: 1; overflow: hidden; background: #fff;">
            <img
              src={product.image}
              alt={product.name}
              style="width: 100%; height: 100%; object-fit: cover;"
            />
          </div>
          <div style="padding: 1.25rem;">
            <div style="font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.3; margin-bottom: 0.75rem; color: var(--color-text);">
              {product.name}
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 1rem; color: var(--color-text);">{product.price}</span>
              <span style="font-size: 12px; color: var(--color-text-faint); text-transform: uppercase; letter-spacing: 0.08em;">{product.styles}</span>
            </div>
            <div style="margin-top: 0.75rem; font-size: 13px; color: var(--color-text-muted); text-decoration: underline; text-underline-offset: 4px;">
              Shop on Bonfire
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Sticker Mule -->
  <section style="padding: 4rem var(--site-gutter); max-width: var(--site-max); margin: 0 auto; border-top: 1px solid var(--color-border);">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
      <div>
        <h2 style="margin-bottom: 0.75rem;">Stickers on Sticker Mule</h2>
        <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.8; margin-bottom: 1.5rem;">
          Pick up SERC stickers on our Sticker Mule shop. A small way to show your support for native reptile and amphibian conservation.
        </p>
        <a href="https://www.stickermule.com/purringturtle" target="_blank" rel="noopener noreferrer" class="btn btn--dark">
          Shop stickers
        </a>
      </div>
      <a href="https://www.stickermule.com/purringturtle" target="_blank" rel="noopener noreferrer" style="display: block; background: var(--color-surface); border: 1px solid var(--color-border); overflow: hidden; text-decoration: none;">
        <div style="padding: 1.5rem; display: flex; justify-content: center; background: #fff;">
          <img
            src="https://storage.googleapis.com/sm-artworks/8e78fd23-17c6-4cdb-b475-5e8898925b00/proof_retina_3x.png?cacheFor=c7ad854cbf1a22a39a07f1cb2df7c67e"
            alt="Susie the Eastern Box Turtle sticker"
            style="width: 220px; height: auto; display: block;"
          />
        </div>
        <div style="padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center;">
          <span style="font-family: var(--font-serif); font-size: 1.1rem; color: var(--color-text);">Susie sticker</span>
          <span style="font-size: 13px; color: var(--color-text-muted); text-decoration: underline; text-underline-offset: 4px;">Shop on Sticker Mule</span>
        </div>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section style="background: var(--color-bg-dark); padding: 5rem var(--site-gutter); text-align: center;">
    <h2 style="font-family: var(--font-serif); font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 300; color: #F5F2EC; margin-bottom: 1rem;">
      View the full store on Bonfire
    </h2>
    <p style="color: #9A9080; max-width: 480px; margin: 0 auto 2rem; line-height: 1.75;">
      Browse all available styles, colors, and sizes. All proceeds support native wildlife rehabilitation.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a
        href="https://www.bonfire.com/store/support-reptile-rehab/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--outline"
        style="border-color: #D5D0C8; color: #D5D0C8;"
      >
        Visit our Bonfire store
      </a>
      <a
        href="https://www.stickermule.com/purringturtle"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--outline"
        style="border-color: #D5D0C8; color: #D5D0C8;"
      >
        Visit our Sticker Mule shop
      </a>
    </div>
  </section>

</Layout>
