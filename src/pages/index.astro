---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Reptile & Amphibian Rescue in Hampton Roads, VA | SERC"
  description="Licensed turtle, reptile, and amphibian rescue serving Hampton Roads and Southeastern Virginia. We rehabilitate injured native turtles, snakes, and frogs — found an injured animal? Here's how to get help."
  image="/images/hero-turtle.jpg"
  schema={{
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "Southeastern Reptile Conservation",
    "alternateName": "SERC",
    "url": "https://www.southeastreptile.org",
    "logo": "https://www.southeastreptile.org/images/serc-logo.png",
    "description": "Licensed nonprofit providing wildlife rehabilitation and reptile, turtle, and amphibian rescue across Hampton Roads and Southeastern Virginia.",
    "email": "info@southeastreptile.org",
    "telephone": "+17573243720",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Hampton Roads" },
      { "@type": "AdministrativeArea", "name": "Southeastern Virginia" },
      { "@type": "City", "name": "Virginia Beach" },
      { "@type": "City", "name": "Norfolk" },
      { "@type": "City", "name": "Chesapeake" },
      { "@type": "City", "name": "Newport News" },
      { "@type": "City", "name": "Hampton" },
      { "@type": "City", "name": "Portsmouth" },
      { "@type": "City", "name": "Suffolk" }
    ],
    "sameAs": [
      "https://www.instagram.com/purringturtle",
      "https://github.com/southeastreptile",
      "https://www.inaturalist.org/people/southeastreptile"
    ],
    "knowsAbout": ["Wildlife Rehabilitation", "Turtle Rescue", "Reptile Rescue", "Snake Rescue", "Amphibian Conservation", "Diamondback Terrapin", "Eastern Box Turtle"]
  }}
>

  <!-- Hero -->
  <section style="background: #B5A090; min-height: 90vh; display: grid; grid-template-columns: 1fr 1fr; align-items: center; overflow: hidden;">
    <div style="padding: clamp(3rem, 8vw, 6rem) clamp(2rem, 6vw, 5rem);">
      <h1 style="font-family: var(--font-serif); font-size: clamp(2.8rem, 5vw, 4.5rem); font-weight: 300; color: var(--color-text); line-height: 1.1; margin-bottom: 1.5rem;">
        Protecting native species.
      </h1>
      <p style="font-size: 1.1rem; color: var(--color-text-muted); line-height: 1.75; margin-bottom: 2rem; max-width: 480px;">
        Southeastern Reptile Conservation is a nonprofit based in Hampton Roads, Virginia,
        dedicated to the conservation, rehabilitation, and protection of native reptiles and
        amphibians. We provide permitted wildlife rehabilitation — turtle, snake, and amphibian
        rescue — across Southeastern Virginia, with the goal of returning animals to the wild.
      </p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem;">
        <a href="/triage" class="btn btn--dark">Found an animal that needs help?</a>
      </div>
    </div>
    <div style="height: 100%; min-height: 90vh; overflow: hidden;">
      <img
        src="/images/hero-turtle.jpg"
        alt="Eastern box turtle in natural habitat"
        width="5472"
        height="3648"
        fetchpriority="high"
        style="width: 100%; height: 100%; object-fit: cover;"
      />
    </div>
  </section>

  <!-- Donate CTA -->
  <section style="background: var(--color-bg-dark); padding: clamp(4.5rem, 9vw, 7rem) var(--site-gutter); text-align: center;">
    <h2 style="font-family: var(--font-serif); font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 300; color: #F5F2EC; margin-bottom: 1.25rem;">
      Support native wildlife rehabilitation
    </h2>
    <p style="color: #C4BBA9; max-width: 560px; margin: 0 auto 2.5rem; line-height: 1.8; font-size: 1.15rem;">
      SERC is a 501(c)(3) nonprofit. Your donation directly supports the care of
      injured and orphaned reptiles and amphibians in Virginia.
    </p>
    <a href="/donate" class="btn btn--accent btn--lg">Donate</a>
  </section>

  <!-- Mission strip -->
  <section style="background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 3rem var(--site-gutter);">
    <div style="max-width: var(--site-max); margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; text-align: center;">
      <div>
        <div style="font-family: var(--font-serif); font-size: 2rem; margin-bottom: 0.5rem;">Rehabilitation</div>
        <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6;">Caring for injured and orphaned native reptiles and amphibians with licensed expertise.</p>
      </div>
      <div>
        <div style="font-family: var(--font-serif); font-size: 2rem; margin-bottom: 0.5rem;">Conservation</div>
        <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6;">Protecting habitats and advocating for species of greatest conservation concern in Virginia.</p>
      </div>
      <div>
        <div style="font-family: var(--font-serif); font-size: 2rem; margin-bottom: 0.5rem;">Education</div>
        <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6;">Building community awareness and using technology to advance conservation outcomes.</p>
      </div>
    </div>
  </section>

  <!-- Found an animal callout -->
  <section style="background: var(--color-accent); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: clamp(3rem, 6vw, 4.5rem) var(--site-gutter);">
    <div style="max-width: var(--site-max); margin: 0 auto; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2.5rem;">
      <div>
        <div style="font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-bg-dark); opacity: 0.7; margin-bottom: 0.6rem;">Need help right now?</div>
        <h2 style="font-family: var(--font-serif); font-size: clamp(1.9rem, 3.5vw, 2.6rem); font-weight: 300; color: var(--color-text); margin-bottom: 0.6rem; line-height: 1.15;">Found an injured reptile or amphibian?</h2>
        <p style="font-size: 1.1rem; color: var(--color-bg-dark); line-height: 1.7; max-width: 520px;">Our triage guide tells you exactly what to do — step by step.</p>
      </div>
      <a href="/triage" class="btn btn--dark btn--lg" style="white-space: nowrap; flex-shrink: 0;">Go to triage guide →</a>
    </div>
  </section>

  <!-- Scope note -->
  <section style="background: #fdf8f2; border-bottom: 1px solid var(--color-border); padding: 1.5rem var(--site-gutter);">
    <div style="max-width: var(--site-max); margin: 0 auto; display: flex; align-items: flex-start; gap: 0.75rem;">
      <span style="color: #a07840; font-size: 1.1rem; line-height: 1.5; flex-shrink: 0;">&#9888;</span>
      <p style="font-size: 15px; color: var(--color-text); line-height: 1.7; margin: 0;">
        <strong style="font-weight: 500;">We work only with native and naturalized Virginia wildlife.</strong>
        We cannot take in exotic or purchased pet species (purchased turtles, tortoises, ball pythons,
        bearded dragons, etc.) and we do not rehome unwanted pets. For exotic species, please contact
        a local reptile rescue.
      </p>
    </div>
  </section>

  <!-- Latest from the blog -->
  <section style="padding: 5rem var(--site-gutter); max-width: var(--site-max); margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border);">
      <h2 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 300;">From the blog</h2>
      <a href="/blog" style="font-size: 13px; text-decoration: underline; text-underline-offset: 4px; color: var(--color-text-muted);">All posts</a>
    </div>
    <a href="/blog/ai-in-wildlife-rehabilitation-from-paper-notes-to-life-saving-insights" class="post-card" style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; text-decoration: none; color: inherit;">
      <div>
        <div class="post-card__date">April 2026</div>
        <div class="post-card__title">AI in wildlife rehabilitation: from paper notes to life-saving insights</div>
        <p class="post-card__excerpt">How we used Claude, Anthropic's AI assistant, to turn handwritten field notes into a working spreadsheet, catch a data error, and surface insights that were invisible on paper.</p>
        <span class="post-card__read-more">Read more</span>
      </div>
      <div class="post-card__image" style="aspect-ratio: 4/3; overflow: hidden;">
        <img src="/images/hatchling-rock.jpg" alt="Diamondback terrapin hatchling" width="3012" height="2846" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
    </a>
  </section>

</Layout>
