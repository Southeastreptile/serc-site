---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Thank You | Report Received"
  description="Thank you for reporting an animal to Southeastern Reptile Conservation. Here's what to do while you wait to hear from us."
  noindex={true}
>

  <section style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 5rem var(--site-gutter); text-align: center;">
    <div style="max-width: 560px;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🐢</div>
      <h1 style="font-size: 2.2rem; margin-bottom: 1rem;">Thank you — we've got your report</h1>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 2rem;">
        A SERC volunteer will review your submission and reach out as soon as we can. While you wait,
        please:
      </p>

      <ul style="list-style: none; text-align: left; display: flex; flex-direction: column; gap: 0.85rem; max-width: 460px; margin: 0 auto 2.5rem; color: var(--color-text-muted); font-size: 16px; line-height: 1.6;">
        <li style="padding-left: 1.4rem; text-indent: -1.4rem;">→ Keep the animal in a quiet, dark, secure container away from pets and children.</li>
        <li style="padding-left: 1.4rem; text-indent: -1.4rem;">→ Do not offer food or water, and don't try to treat it yourself.</li>
        <li style="padding-left: 1.4rem; text-indent: -1.4rem;">→ Text photos to <a href="sms:7573243720" style="color: var(--color-text); text-decoration: underline; text-underline-offset: 3px;">757-324-3720</a> — they help us assess the animal quickly.</li>
        <li style="padding-left: 1.4rem; text-indent: -1.4rem;">→ For anything urgent, text that number rather than waiting on email.</li>
      </ul>

      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/triage" class="btn btn--dark">Read the triage guide</a>
        <a href="/" class="btn btn--outline">Back to home</a>
      </div>
    </div>
  </section>

</Layout>
