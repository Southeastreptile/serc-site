---
import Layout from '../layouts/Layout.astro';

// Shared Google Drive folder (invite-only). Manage access from Drive's sharing settings.
const DRIVE_URL = 'https://drive.google.com/drive/folders/1sSIvS8w8yoMq8L0qwLHAMNDffQvyIkJG?usp=sharing';

// Set to true to re-enable the access-controlled resource library section.
const SHOW_LIBRARY = false;

// Suggested-supplies section is hidden for now (Amazon affiliate links kept out
// of the site while Google Ad Grants is being set up). Set to true to re-enable.
const SHOW_SUPPLIES = false;

// Suggested supplies. Amazon affiliate links (tag: southeastrept-20).
const supplies = [
  {
    category: 'Food & supplements',
    items: [
      { name: 'Mazuri Aquatic Turtle Food (Freshwater Formula)', url: 'https://amzn.to/4fedV2n' },
      { name: 'Zoo Med Natural Aquatic Turtle Food, Hatchling Formula', url: 'https://amzn.to/3T4oMDx' },
      { name: 'Carlson Cod Liver Oil (vitamin A/D source)', url: 'https://amzn.to/4hoKgVt' },
      { name: 'Herptivite Multivitamin & Mineral Powder', url: 'https://amzn.to/4pKzj2L' },
      { name: 'Phosphorus-Free Calcium with Vitamin D3 (ultrafine powder)', url: 'https://amzn.to/4x7TOJj' },
    ],
  },
  {
    category: 'Water & habitat',
    items: [
      { name: 'Fluval U3 Underwater Filter', url: 'https://amzn.to/4fMNRLV' },
      { name: 'Zilla Aquatic Submersible Heater', url: 'https://amzn.to/44DFyfh' },
      { name: 'Jasonwell Foldable Pool (soaking & temporary setups)', url: 'https://amzn.to/3RLprt6' },
      { name: 'Reptile Food & Water Dish with Ramp and Basking Platform', url: 'https://amzn.to/4fB6alU' },
    ],
  },
  {
    category: 'Lighting',
    items: [
      { name: 'Zoo Med ReptiSun 5.0 Mini Compact UVB Lamp', url: 'https://amzn.to/4vKIdif' },
      { name: 'Zoo Med ReptiSun T5 HO Hood with 10.0 UVB Bulb', url: 'https://amzn.to/4fM6gsa' },
      { name: 'Reptile Systems Eco T5 Zone 2 Lighting Kit (36in / 39W)', url: 'https://amzn.to/4wpWGRV' },
      { name: 'Reptile Basking Heat Lamp Bulbs (75W, 2-pack)', url: 'https://amzn.to/4fUCHET' },
    ],
  },
  {
    category: 'Substrate & bedding',
    items: [
      { name: 'Zoo Med ReptiSoil', url: 'https://amzn.to/4b6hiGh' },
      { name: 'Zilla Coconut Husk Brick (egg incubation & tropical bedding)', url: 'https://amzn.to/4fuF6VA' },
    ],
  },
  {
    category: 'Medical & cleaning',
    items: [
      { name: 'Manuka Honey Gauze Dressing (wound care)', url: 'https://amzn.to/4gRcVCv' },
      { name: 'Manuka Honey, UMF 10+ / MGO 250+ (wound care)', url: 'https://amzn.to/4x41yfj' },
      { name: 'Oxivir Tb Surface Disinfectant', url: 'https://amzn.to/4ypSLWu' },
    ],
  },
];

// Publicly shareable guides and whitepapers. Add new entries here.
const guides = [
  {
    title: 'Head-starting Eastern Box Turtles',
    description: 'Our approach to head-starting Eastern box turtle hatchlings — husbandry, measurement, and release readiness.',
    url: 'https://drive.google.com/file/d/1EYdIJbuL072JlHKs60dfyaJ0AvUKuj25/view?usp=sharing',
  },
];
---

<Layout
  title="Rehabber Resources"
  description="Resources for licensed wildlife rehabilitators working with native Virginia reptiles and amphibians."
  noindex={true}
>

  <!-- Disclaimer banner -->
  <section style="background: #fdf8f2; border-bottom: 1px solid #c8b898;">
    <div style="max-width: var(--site-max); margin: 0 auto; padding: 1.5rem var(--site-gutter); display: flex; align-items: flex-start; gap: 0.75rem;">
      <span style="color: #a07840; font-size: 1.1rem; line-height: 1.5; flex-shrink: 0;">&#9888;</span>
      <p style="font-size: 15px; color: var(--color-text); line-height: 1.7; margin: 0;">
        <strong style="font-weight: 500;">For licensed wildlife rehabilitators.</strong>
        This page is intended for permitted rehabbers and volunteers working under supervision. Nothing
        here replaces veterinary care, your permit conditions, or state and federal regulations. If you
        are a member of the public who has found an animal, please use our
        <a href="/triage" style="color: var(--color-text); text-decoration: underline; text-underline-offset: 3px;">triage guide</a> instead.
      </p>
    </div>
  </section>

  <!-- Header -->
  <section style="padding: 4rem var(--site-gutter) 2rem; max-width: var(--site-max); margin: 0 auto;">
    <span style="font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-faint); display: block; margin-bottom: 1rem;">For our community of rehabbers</span>
    <h1 style="margin-bottom: 1rem;">Rehabber resources</h1>
    <p style="max-width: 620px; color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.8;">
      A place to share what we have learned caring for native Virginia reptiles and amphibians. General
      references live on this page. An access-controlled library of detailed medical protocols, dosing
      references, and intake forms is in the works and will be added here soon.
    </p>
  </section>

  <!-- General resources (public-facing, editable) -->
  <section style="padding: 1rem var(--site-gutter) 3rem; max-width: var(--site-max); margin: 0 auto; border-bottom: 1px solid var(--color-border);">
    <h2 style="margin-bottom: 1.5rem;">General references</h2>
    <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem; max-width: 720px;">
      <li style="font-size: 16px; color: var(--color-text-muted); line-height: 1.7;">
        <a href="/species" style="color: var(--color-text); text-decoration: underline; text-underline-offset: 3px;">Virginia field guide</a>
        &mdash; identification, conservation status, and habitat notes for native turtles, snakes, frogs, and salamanders.
      </li>
      <li style="font-size: 16px; color: var(--color-text-muted); line-height: 1.7;">
        <a href="/triage" style="color: var(--color-text); text-decoration: underline; text-underline-offset: 3px;">Public triage guide</a>
        &mdash; what we tell finders to do, so your intake calls start from the same page.
      </li>
      <!-- Add more general references here as needed. -->
    </ul>
  </section>

  <!-- Guides & whitepapers -->
  <section style="padding: 3rem var(--site-gutter); max-width: var(--site-max); margin: 0 auto; border-bottom: 1px solid var(--color-border);">
    <h2 style="margin-bottom: 0.5rem;">Guides &amp; whitepapers</h2>
    <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.7; max-width: 620px; margin-bottom: 2rem;">
      Practical guides and papers we've written from our own rehabilitation work, free to read and share.
    </p>
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; max-width: 900px;">
      {guides.map(g => (
        <a href={g.url} target="_blank" rel="noopener" style="display: block; background: var(--color-surface); border: 1px solid var(--color-border); padding: 1.5rem; text-decoration: none; color: inherit; transition: border-color 0.2s;">
          <div style="display: flex; align-items: flex-start; gap: 0.85rem;">
            <span style="flex-shrink: 0; color: var(--color-text-faint);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h8"/><path d="M8 9h2"/></svg>
            </span>
            <div>
              <div style="font-family: var(--font-serif); font-size: 1.2rem; margin-bottom: 0.35rem; color: var(--color-text);">{g.title}</div>
              <p style="font-size: 14px; color: var(--color-text-muted); line-height: 1.6; margin: 0;">{g.description}</p>
              <span style="display: inline-block; margin-top: 0.75rem; font-size: 13px; color: var(--color-text); text-decoration: underline; text-underline-offset: 3px;">Open guide &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Suggested supplies (hidden for now; toggle SHOW_SUPPLIES above) -->
  {SHOW_SUPPLIES && (
  <section style="padding: 3rem var(--site-gutter); max-width: var(--site-max); margin: 0 auto; border-bottom: 1px solid var(--color-border);">
    <h2 style="margin-bottom: 0.5rem;">Suggested supplies</h2>
    <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.7; max-width: 620px; margin-bottom: 1.25rem;">
      Products we use and recommend for reptile and amphibian rehabilitation, organized by purpose.
    </p>
    <p style="font-size: 13px; color: var(--color-text-faint); line-height: 1.7; max-width: 620px; margin-bottom: 2rem; padding: 0.85rem 1.1rem; background: var(--color-surface); border: 1px solid var(--color-border);">
      As an Amazon Associate, SERC earns from qualifying purchases. The links below are affiliate links,
      so we may receive a small commission at no extra cost to you &mdash; which helps fund the animals in our care.
    </p>
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 2.5rem; max-width: 900px;">
      {supplies.map(group => (
        <div>
          <div style="font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 0.85rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--color-border);">{group.category}</div>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.65rem;">
            {group.items.map(item => (
              <li style="font-size: 15px; line-height: 1.5;">
                <a href={item.url} target="_blank" rel="noopener sponsored nofollow" style="color: var(--color-text); text-decoration: underline; text-underline-offset: 3px;">{item.name}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  )}

  <!-- Access-controlled library (hidden until fleshed out; toggle SHOW_LIBRARY above) -->
  {SHOW_LIBRARY && (
    <section style="padding: 3rem var(--site-gutter); max-width: var(--site-max); margin: 0 auto;">
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-left: 3px solid var(--color-text); padding: 2rem 2rem;">
        <div style="font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 0.5rem;">Access-controlled</div>
        <h2 style="font-family: var(--font-serif); font-size: 1.6rem; font-weight: 300; margin-bottom: 0.75rem;">Full rehabber resource library</h2>
        <p style="font-size: 16px; color: var(--color-text-muted); line-height: 1.75; margin-bottom: 1.5rem; max-width: 620px;">
          Medical protocols, dosing references, intake and measurement forms, and other sensitive
          materials are kept in a private Google Drive shared only with approved rehabbers and volunteers.
          Access is granted by invitation so we can keep this information out of the wrong hands.
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href={DRIVE_URL} target="_blank" rel="noopener" class="btn btn--dark">Open the resource library</a>
          <a href="mailto:info@southeastreptile.org?subject=Rehabber%20resource%20access" class="btn btn--outline">Request access</a>
        </div>
      </div>
    </section>
  )}

</Layout>
