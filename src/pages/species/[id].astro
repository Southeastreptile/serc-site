---
import Layout from '../../layouts/Layout.astro';

import turtles from '../../content/species/virginia-turtles.json';
import snakes from '../../content/species/virginia-snakes.json';
import frogsToads from '../../content/species/virginia-frogs-toads.json';
import salamanders from '../../content/species/virginia-salamanders.json';

export function getStaticPaths() {
  const all: any[] = [
    ...(turtles as any[]),
    ...(snakes as any[]),
    ...(frogsToads as any[]),
    ...(salamanders as any[]),
  ];
  return all.map((s) => ({
    params: { id: s.id },
    props: {
      species: s,
      resolvedSimilar: (s.similarSpecies || []).map((sim: any) => ({
        id: sim.id,
        differentiator: sim.differentiator,
        speciesData: all.find((sp) => sp.id === sim.id) || null,
      })),
    },
  }));
}

const { species: s, resolvedSimilar } = Astro.props as any;

const iucnLabel: Record<string, string> = {
  LC: 'Least Concern',
  NT: 'Near Threatened',
  VU: 'Vulnerable',
  EN: 'Endangered',
  CR: 'Critically Endangered',
  DD: 'Data Deficient',
  NE: 'Not Evaluated',
};

const iucnColor: Record<string, string> = {
  CR: '#8a3228',
  EN: '#9c6b30',
  VU: '#9c6b30',
  NT: '#7a7060',
  LC: '#4a7c59',
};

const statusColor: Record<string, string> = {
  'endangered':        '#8a3228',
  'threatened':        '#9c6b30',
  'special concern':   '#7a7060',
  'species of concern':'#7a7060',
};

function cap(str: string): string {
  if (!str || str === 'none') return 'None';
  return str.charAt(0).toUpperCase() + str.slice(1);
}

const cs = s.conservationStatus;
const isVenomous   = s.venomous === true;
const isNaturalized = s.nativeStatus !== undefined && s.nativeStatus !== 'native';
const shortDesc    = (s.description as string).split('.')[0] + '.';
const pageTitle    = `${s.commonName} (${s.scientificName}) — Virginia Species Guide`;
---

<Layout
  title={pageTitle}
  description={shortDesc}
  type="article"
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": `${s.commonName} — Virginia Species Profile`,
      "description": shortDesc,
      "author": {
        "@type": "Organization",
        "name": "Southeastern Reptile Conservation",
        "url": "https://www.southeastreptile.org"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Southeastern Reptile Conservation",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.southeastreptile.org/images/serc-logo.png"
        }
      },
      "about": {
        "@type": "Taxon",
        "name": s.scientificName,
        "commonName": s.commonName
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",       "item": "https://www.southeastreptile.org/" },
        { "@type": "ListItem", "position": 2, "name": "Field guide", "item": "https://www.southeastreptile.org/species" },
        { "@type": "ListItem", "position": 3, "name": s.commonName,  "item": `https://www.southeastreptile.org/species/${s.id}` }
      ]
    }
  ]}
>

<style>
  .sp-profile {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 0 var(--site-gutter) 6rem;
  }

  /* Breadcrumb */
  .sp-breadcrumb {
    padding: 1.5rem 0 0;
    font-size: 12px;
    color: var(--color-text-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sp-breadcrumb a {
    color: var(--color-text-faint);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sp-breadcrumb a:hover { color: var(--color-text-muted); }

  /* Hero */
  .sp-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
    align-items: start;
  }

  .sp-photo-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .sp-photo {
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    position: relative;
    overflow: hidden;
  }

  #sp-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
    position: absolute;
    inset: 0;
  }

  .sp-photo__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--color-border);
  }

  .sp-photo__attr {
    display: none;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.5rem 0.75rem;
    font-size: 10px;
    color: rgba(255,255,255,0.75);
    background: linear-gradient(transparent, rgba(0,0,0,0.5));
    line-height: 1.4;
  }

  #sp-inat-photo-link {
    display: none;
    font-size: 12px;
    color: var(--color-text-faint);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #sp-inat-photo-link:hover { color: var(--color-text-muted); }

  /* Hero content */
  .sp-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .sp-hero__kicker {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .sp-hero__name {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 300;
    line-height: 1.15;
    margin: 0;
    color: var(--color-text);
  }

  .sp-hero__sci {
    font-style: italic;
    color: var(--color-text-faint);
    font-size: 14px;
    margin-top: -0.5rem;
  }

  .sp-venomous-bar {
    background: #8a3228;
    color: #fff;
    padding: 0.5rem 0.875rem;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sp-size {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Status grid */
  .sp-status-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
  }

  .sp-status-cell {
    padding: 0.625rem 0.875rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .sp-status-cell:nth-child(even)       { border-right: none; }
  .sp-status-cell:nth-last-child(-n+2)  { border-bottom: none; }

  .sp-status-cell__label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 0.2rem;
  }

  .sp-status-cell__value {
    font-size: 12px;
    font-weight: 500;
  }

  /* Tag rows */
  .sp-label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 0.4rem;
    display: block;
  }

  .sp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .sp-tag {
    font-size: 11px;
    padding: 3px 9px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* Sections */
  .sp-section {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .sp-section h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  /* ID list */
  .sp-id-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 680px;
  }

  .sp-id-list li {
    display: flex;
    gap: 0.75rem;
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .sp-id-list li::before {
    content: '—';
    color: var(--color-text-faint);
    flex-shrink: 0;
  }

  /* Similar species */
  .sp-similar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .sp-similar-card {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    display: block;
    transition: border-color 0.15s;
  }

  .sp-similar-card:not([href]) { cursor: default; }
  .sp-similar-card[href]:hover { border-color: var(--color-text-muted); }

  .sp-similar-card__name {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .sp-similar-card__diff {
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* Fun fact */
  .sp-funfact {
    background: var(--color-surface);
    border-left: 3px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.8;
    font-style: italic;
    margin: 0;
    max-width: 680px;
  }

  /* SERC notes */
  .sp-notes {
    background: #f0ead8;
    border: 1px solid #c8b898;
    padding: 1.25rem 1.5rem;
    font-size: 14px;
    color: #5a4e3a;
    line-height: 1.75;
    max-width: 680px;
  }

  .sp-notes__label {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a7a55;
    display: block;
    margin-bottom: 0.5rem;
  }

  /* iNat link */
  .sp-inat-link {
    font-size: 14px;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .sp-inat-link:hover { color: var(--color-text); }
</style>

<div class="sp-profile">

  <!-- Breadcrumb -->
  <nav class="sp-breadcrumb" aria-label="Breadcrumb">
    <a href="/species">Field guide</a>
    <span aria-hidden="true">›</span>
    <span>{s.commonName}</span>
  </nav>

  <!-- Hero -->
  <div class="sp-hero">

    <!-- Photo -->
    <div class="sp-photo-wrap">
      <div class="sp-photo">
        <img id="sp-photo-img" src="" alt={s.commonName} />
        <div class="sp-photo__placeholder" id="sp-photo-placeholder">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1">
            <ellipse cx="28" cy="34" rx="18" ry="13" />
            <ellipse cx="28" cy="20" rx="7" ry="6" />
          </svg>
          <span style="font-size:11px;">Loading photo...</span>
        </div>
        <div class="sp-photo__attr" id="sp-photo-attr"></div>
      </div>
      {s.inatTaxonId && (
        <a
          id="sp-inat-photo-link"
          href={`https://www.inaturalist.org/taxa/${s.inatTaxonId}`}
          target="_blank"
          rel="noopener"
        >
          View on iNaturalist ↗
        </a>
      )}
    </div>

    <!-- Details -->
    <div class="sp-hero__content">
      <div class="sp-hero__kicker">{s.group} &nbsp;·&nbsp; {s.subgroup}</div>

      {isVenomous && (
        <div class="sp-venomous-bar">⚠ Venomous</div>
      )}

      <h1 class="sp-hero__name">{s.commonName}</h1>
      <p class="sp-hero__sci">{s.scientificName} — {s.family}</p>

      {s.sizeRange && (
        <p class="sp-size">
          {s.sizeRange.minIn}–{s.sizeRange.maxIn} inches
          {s.sizeRange.notes && (
            <span style="color:var(--color-text-faint);font-size:12px;display:block;margin-top:0.1rem;">{s.sizeRange.notes}</span>
          )}
        </p>
      )}

      <!-- Conservation status -->
      <div class="sp-status-grid">
        <div class="sp-status-cell">
          <div class="sp-status-cell__label">IUCN</div>
          <div
            class="sp-status-cell__value"
            style={`color:${iucnColor[cs.iucn] || 'var(--color-text-faint)'}`}
          >
            {iucnLabel[cs.iucn] || cs.iucn || 'Not Evaluated'}
          </div>
        </div>
        <div class="sp-status-cell">
          <div class="sp-status-cell__label">Federal (US)</div>
          <div
            class="sp-status-cell__value"
            style={`color:${statusColor[cs.federal] || 'var(--color-text-faint)'}`}
          >
            {cap(cs.federal)}
          </div>
        </div>
        <div class="sp-status-cell">
          <div class="sp-status-cell__label">Virginia</div>
          <div
            class="sp-status-cell__value"
            style={`color:${statusColor[cs.virginia] || 'var(--color-text-faint)'}`}
          >
            {cap(cs.virginia)}
          </div>
        </div>
        <div class="sp-status-cell">
          <div class="sp-status-cell__label">VWAP Tier</div>
          <div class="sp-status-cell__value" style="color:var(--color-text-muted);">
            {s.vwapTier && s.vwapTier !== 'none' ? s.vwapTier : 'Not Listed'}
          </div>
        </div>
      </div>

      <!-- Habitat -->
      {s.habitat && s.habitat.length > 0 && (
        <div>
          <span class="sp-label">Habitat</span>
          <div class="sp-tags">
            {(s.habitat as string[]).map((h) => <span class="sp-tag">{h}</span>)}
          </div>
        </div>
      )}

      <!-- Region -->
      {s.regions && s.regions.length > 0 && (
        <div>
          <span class="sp-label">Found in Virginia</span>
          <div class="sp-tags">
            {(s.regions as string[]).map((r) => (
              <span class="sp-tag">
                {r === 'statewide' ? 'Statewide' : r.charAt(0).toUpperCase() + r.slice(1)}
              </span>
            ))}
          </div>
        </div>
      )}

      {isNaturalized && (
        <p style="font-size:12px;color:var(--color-text-faint);border-top:1px solid var(--color-border);padding-top:0.75rem;margin:0;">
          This species is naturalized in Virginia but is not native.
        </p>
      )}
    </div>
  </div>

  <!-- Identification -->
  {s.identificationFeatures && (s.identificationFeatures as any[]).length > 0 && (
    <section class="sp-section">
      <h2>How to identify</h2>
      <ul class="sp-id-list">
        {(s.identificationFeatures as string[]).map((f) => <li>{f}</li>)}
      </ul>
    </section>
  )}

  <!-- Description -->
  <section class="sp-section">
    <h2>About this species</h2>
    <p style="font-size:15px;color:var(--color-text-muted);line-height:1.85;max-width:680px;">
      {s.description}
    </p>
  </section>

  <!-- Similar species -->
  {resolvedSimilar && (resolvedSimilar as any[]).length > 0 && (
    <section class="sp-section">
      <h2>Often confused with</h2>
      <div class="sp-similar-grid">
        {(resolvedSimilar as any[]).map((sim) => (
          sim.speciesData ? (
            <a href={`/species/${sim.id}`} class="sp-similar-card">
              <div class="sp-similar-card__name">{sim.speciesData.commonName}</div>
              <div class="sp-similar-card__diff">{sim.differentiator}</div>
            </a>
          ) : (
            <div class="sp-similar-card">
              <div class="sp-similar-card__name" style="text-transform:capitalize;">
                {(sim.id as string).replace(/-/g, ' ')}
              </div>
              <div class="sp-similar-card__diff">{sim.differentiator}</div>
            </div>
          )
        ))}
      </div>
    </section>
  )}

  <!-- Fun fact -->
  {s.funFact && (
    <section class="sp-section">
      <h2>Did you know</h2>
      <blockquote class="sp-funfact">"{s.funFact}"</blockquote>
    </section>
  )}

  <!-- SERC notes -->
  {s.sercNotes && (
    <section class="sp-section">
      <div class="sp-notes">
        <span class="sp-notes__label">SERC rehabilitation notes</span>
        {s.sercNotes}
      </div>
    </section>
  )}

  <!-- iNaturalist link -->
  {s.inatTaxonId && (
    <section class="sp-section">
      <h2>Sightings &amp; citizen science</h2>
      <p style="font-size:15px;color:var(--color-text-muted);line-height:1.8;margin-bottom:1rem;max-width:540px;">
        Help document Virginia wildlife by logging your sightings on iNaturalist.
        Every observation builds the conservation data that researchers and rehabbers depend on.
      </p>
      <a
        href={`https://www.inaturalist.org/taxa/${s.inatTaxonId}`}
        target="_blank"
        rel="noopener"
        class="sp-inat-link"
      >
        View {s.commonName} observations on iNaturalist ↗
      </a>
    </section>
  )}

  <!-- Found one injured? -->
  <section class="sp-section" style="border-bottom:none; background: var(--color-surface); border-top: 1px solid var(--color-border); padding: 2rem 3rem; margin: 0;">
    <div style="display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2rem; max-width: 700px;">
      <div>
        <div style="font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 0.4rem;">Found one injured?</div>
        <p style="font-size: 15px; color: var(--color-text-muted); line-height: 1.7; margin: 0;">
          If you've found an injured or displaced {s.commonName} in Virginia, our triage guide walks you through what to do.
        </p>
      </div>
      <a href="/triage" class="btn btn--dark" style="white-space: nowrap; flex-shrink: 0;">Triage guide →</a>
    </div>
  </section>

</div>

<script define:vars={{ inatTaxonId: s.inatTaxonId }}>
  if (inatTaxonId) {
    const imgEl      = document.getElementById('sp-photo-img');
    const placeholder = document.getElementById('sp-photo-placeholder');
    const attrEl     = document.getElementById('sp-photo-attr');
    const inatLink   = document.getElementById('sp-inat-photo-link');

    fetch('https://api.inaturalist.org/v1/taxa?id=' + inatTaxonId + '&per_page=1')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        const taxon = data.results && data.results[0];
        if (!taxon || !taxon.default_photo) return;
        const photo = taxon.default_photo;
        imgEl.onload = function () {
          imgEl.style.display = 'block';
          if (placeholder) placeholder.style.display = 'none';
          if (photo.attribution && attrEl) {
            attrEl.textContent = photo.attribution;
            attrEl.style.display = 'block';
          }
          if (inatLink) inatLink.style.display = 'inline';
        };
        imgEl.src = photo.medium_url || photo.url;
      })
      .catch(function () {});
  }
</script>

</Layout>
