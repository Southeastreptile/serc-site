---
import Layout from '../layouts/Layout.astro';

// After you deploy the Google Apps Script web app (see setup notes), paste its
// /exec URL here. Until then the form will submit and redirect, but won't save.
const INTAKE_ENDPOINT = 'REPLACE_WITH_APPS_SCRIPT_EXEC_URL';

const inputStyle = 'width: 100%; padding: 10px 14px; background: var(--color-bg-light); border: 1px solid var(--color-border); font-family: var(--font-sans); font-size: 15px; color: var(--color-text); outline: none;';
const labelStyle = 'display: block; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 6px;';
---

<Layout
  title="Report an Animal | Wildlife Intake Form"
  description="Report an injured, orphaned, or displaced native reptile or amphibian to Southeastern Reptile Conservation. Serving Hampton Roads and Southeastern Virginia."
>

  <!-- Header + scope note -->
  <section style="padding: 4rem var(--site-gutter) 1.5rem; max-width: 760px; margin: 0 auto;">
    <span style="font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-faint); display: block; margin-bottom: 1rem;">Wildlife intake form</span>
    <h1 style="margin-bottom: 1rem;">Report an animal</h1>
    <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.25rem;">
      Found an injured, orphaned, or displaced native reptile or amphibian in Hampton Roads or
      Southeastern Virginia? Fill out this form and we'll be in touch. If you haven't already, please
      read our <a href="/triage" style="color: var(--color-text); text-decoration: underline; text-underline-offset: 3px;">triage guide</a> first.
    </p>
    <div style="padding: 1rem 1.25rem; background: #fdf8f2; border: 1px solid #c8b898; border-left: 3px solid #a07840; font-size: 14px; color: var(--color-text); line-height: 1.7;">
      <strong style="font-weight: 500;">Native and naturalized Virginia wildlife only.</strong>
      We can't take exotic or purchased pets. For a sick or injured animal that needs help right now,
      the fastest way to reach us is to text <a href="sms:7573243720" style="color: var(--color-text); text-decoration: underline;">757-324-3720</a>.
    </div>
  </section>

  <!-- Form -->
  <section style="padding: 0 var(--site-gutter) 5rem; max-width: 760px; margin: 0 auto;">
    <form id="intake-form" style="display: flex; flex-direction: column; gap: 1.5rem;">

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="name" style={labelStyle}>Your full name *</label>
          <input type="text" id="name" name="name" required style={inputStyle} />
        </div>
        <div>
          <label for="phone" style={labelStyle}>Phone number *</label>
          <input type="tel" id="phone" name="phone" required style={inputStyle} />
        </div>
      </div>

      <div>
        <label for="email" style={labelStyle}>Email *</label>
        <input type="email" id="email" name="email" required style={inputStyle} />
      </div>

      <div>
        <label for="address" style={labelStyle}>Your address (city and ZIP is fine)</label>
        <input type="text" id="address" name="address" style={inputStyle} />
      </div>

      <hr style="border: none; border-top: 1px solid var(--color-border); margin: 0.5rem 0;" />

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <label for="species" style={labelStyle}>Species or best guess</label>
          <input type="text" id="species" name="species" placeholder="Not sure is fine" style={inputStyle} />
        </div>
        <div>
          <label for="dateFound" style={labelStyle}>Date found</label>
          <input type="date" id="dateFound" name="dateFound" style={inputStyle} />
        </div>
      </div>

      <div>
        <label for="location" style={labelStyle}>Where you found it (if different from your address)</label>
        <input type="text" id="location" name="location" style={inputStyle} />
      </div>

      <div>
        <label style={labelStyle}>Reason for intake</label>
        <div style="display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; font-size: 15px; color: var(--color-text); padding-top: 4px;">
          <label style="display: flex; align-items: center; gap: 6px; font-weight: 400; text-transform: none; letter-spacing: 0;"><input type="radio" name="reason" value="Injured" /> Injured</label>
          <label style="display: flex; align-items: center; gap: 6px; font-weight: 400; text-transform: none; letter-spacing: 0;"><input type="radio" name="reason" value="Orphaned" /> Orphaned</label>
          <label style="display: flex; align-items: center; gap: 6px; font-weight: 400; text-transform: none; letter-spacing: 0;"><input type="radio" name="reason" value="Displaced" /> Displaced</label>
          <label style="display: flex; align-items: center; gap: 6px; font-weight: 400; text-transform: none; letter-spacing: 0;"><input type="radio" name="reason" value="Sick" /> Sick</label>
          <label style="display: flex; align-items: center; gap: 6px; font-weight: 400; text-transform: none; letter-spacing: 0;"><input type="radio" name="reason" value="Other" /> Other</label>
        </div>
      </div>

      <div>
        <label for="details" style={labelStyle}>Details about the rescue or anything else relevant</label>
        <textarea id="details" name="details" rows="5" style={inputStyle + ' resize: vertical;'}></textarea>
      </div>

      <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 14px; color: var(--color-text-muted); line-height: 1.6;">
        <input type="checkbox" id="native" name="native" required style="margin-top: 4px; flex-shrink: 0;" />
        This is a native wild animal found in Virginia (not an exotic or purchased pet). *
      </label>

      <p style="font-size: 13px; color: var(--color-text-faint); line-height: 1.6; margin: 0;">
        Have photos? They help a lot. Text them to 757-324-3720 after you submit.
      </p>

      <button type="submit" id="intake-submit" class="btn btn--dark" style="align-self: flex-start;">Submit report</button>
      <p id="intake-error" style="display: none; color: #8a3228; font-size: 14px; margin: 0;">Something went wrong. Please text 757-324-3720 or email info@southeastreptile.org instead.</p>
    </form>
  </section>

  <script is:inline define:vars={{ INTAKE_ENDPOINT }}>
    (function () {
      var form = document.getElementById('intake-form');
      var btn = document.getElementById('intake-submit');
      var err = document.getElementById('intake-error');
      if (!form) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Submitting…';
        err.style.display = 'none';

        if (typeof window.gtag === 'function') window.gtag('event', 'intake_submit');

        var data = new URLSearchParams(new FormData(form));

        function go() { window.location.href = '/intake/thank-you'; }

        if (!INTAKE_ENDPOINT || INTAKE_ENDPOINT.indexOf('REPLACE') === 0) {
          // Endpoint not configured yet — still redirect so the flow is visible.
          go();
          return;
        }

        fetch(INTAKE_ENDPOINT, { method: 'POST', mode: 'no-cors', body: data })
          .then(go)
          .catch(function () {
            btn.disabled = false;
            btn.textContent = 'Submit report';
            err.style.display = 'block';
          });
      });
    })();
  </script>

</Layout>
