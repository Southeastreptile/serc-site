---
import Layout from '../layouts/Layout.astro';
import { formatEventDate, isUpcoming } from '../data/events.js';

// Speaking engagements, kept as a record (past talks stay listed).
// `date` is ISO YYYY-MM-DD when known; otherwise leave it null and set `year`
// so the entry still sorts and displays. `title` is the talk title and is
// optional; when missing, the event name is used as the heading.
// `format`: Talk | Poster | Workshop | Panel | Virtual talk.
const talks = [
  {
    title: 'Practical AI for Wildlife Rehabilitators',
    event: 'Call of the Wild Conference',
    format: 'Virtual talk',
    date: '2026-11-22',
    time: '2:15 to 3:25 PM',
    location: 'Virtual',
  },
  {
    title: 'Keep It Secret, Keep It Safe: Threat Modeling Vulnerable Species Data',
    event: 'BSides Hampton Roads',
    format: 'Talk',
    date: '2026-10-10',
    time: '11:00 to 11:45 AM',
    location: 'Hampton Roads, VA',
  },
  {
    title: 'Head-starting diamondback terrapins (Malaclemys terrapin): raising a hatchling group from egg to release in a coastal Virginia rehabilitation program',
    // Optional: same title with markup, used for italic scientific names.
    titleHtml: 'Head-starting diamondback terrapins (<em>Malaclemys terrapin</em>): raising a hatchling group from egg to release in a coastal Virginia rehabilitation program',
    event: 'SEPARC Annual Meeting',
    eventFull: 'Southeast Partners in Amphibian and Reptile Conservation',
    format: 'Poster',
    date: '2026-09-19',
  },
  {
    title: 'The turtles have an AI now',
    event: 'Resonate 757',
    format: 'Talk',
    date: '2026-08-28',
    location: 'Hampton Roads, VA',
  },
  {
    title: 'Integrating Technology and Husbandry Innovations to Improve Overwintering Success in Rehabilitating Native Turtles',
    event: '23rd Annual TSA Symposium',
    eventFull: 'Turtle Survival Alliance',
    format: 'Talk',
    date: '2025-07-24',
    location: 'Chattanooga, TN',
  },
];

// Sort newest first. Dated talks sort by date; undated ones sort by year and
// otherwise keep the order written above.
const sortKey = (t) => t.date || `${t.year}-00-00`;
const talksSorted = talks
  .map((t, i) => ({ t, i }))
  .sort((a, b) => sortKey(b.t).localeCompare(sortKey(a.t)) || a.i - b.i)
  .map(({ t }) => t);

const talkDate = (t) => (t.date ? formatEventDate(t.date) : String(t.year));
---

<Layout
  title="Licensed Wildlife Rehabilitators in Hampton Roads, VA | About SERC"
  description="Licensed reptile and amphibian rehabilitators serving Hampton Roads and Southeastern Virginia. SERC is a 501(c)(3) nonprofit caring for injured native turtles, snakes, frogs, and salamanders."
  image="/images/box-turtle-grass.jpg"
>

  <!-- Hero -->
  <section style="display: grid; grid-template-columns: 1fr 1fr; min-height: 70vh; background: var(--color-bg);">
    <div style="padding: clamp(3rem, 8vw, 6rem) clamp(2rem, 6vw, 5rem); display: flex; flex-direction: column; justify-content: center;">
      <h1 style="margin-bottom: 1.5rem;">Who we are</h1>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.25rem;">
        Southeastern Reptile Conservation (SERC) is a Virginia-based nonprofit dedicated to the
        conservation, rehabilitation, and protection of native reptiles and amphibians. We provide
        permitted wildlife rehabilitation for injured and displaced native species with the goal of
        returning them to the wild, while also supporting habitat stewardship, public education,
        and conservation-focused technology to ensure native species can thrive in their natural
        ecosystems.
      </p>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.8;">
        Our rehabbers hold the appropriate Virginia DWR Wildlife Rehabilitation permits to legally
        care for native species. SERC operates as a federally recognized 501(c)(3) public charity.
      </p>
    </div>
    <div style="overflow: hidden; min-height: 500px;">
      <img
        src="/images/box-turtle-grass.jpg"
        alt="Eastern box turtle in grass"
        width="5472"
        height="3648"
        fetchpriority="high"
        style="width: 100%; height: 100%; object-fit: cover;"
      />
    </div>
  </section>

  <!-- Speaking and outreach -->
  <section id="speaking" class="speaking" style="background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div class="section">
      <h2 style="margin-bottom: 0.5rem;">Speaking and outreach</h2>
      <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.8; max-width: 640px; margin-bottom: 2.5rem;">
        SERC shares what we learn in rehab with other rehabbers, researchers, and the public.
        Linda Nichols, our founder, has presented on turtle rehabilitation and the open-source
        tools we build to support it.
      </p>
      <ol class="speaking__list">
        {talksSorted.map((t) => (
          <li class="talk">
            <div class="talk__date">
              {t.date ? <time datetime={t.date}>{talkDate(t)}</time> : <span>{talkDate(t)}</span>}
              {t.time && <div class="talk__time">{t.time}</div>}
            </div>
            <div>
              <div class="talk__pills">
                {t.format && <span class="tag">{t.format}</span>}
                {isUpcoming(t) && <span class="tag talk__upcoming" data-hide-after={t.date}>Upcoming</span>}
              </div>
              {t.titleHtml
                ? <h3 class="talk__title" set:html={t.titleHtml} />
                : <h3 class="talk__title">{t.title || t.event}</h3>}
              <div class="talk__meta">
                {t.title && <span>{t.event}</span>}
                {t.title && t.eventFull && <span> ({t.eventFull})</span>}
                {!t.title && t.eventFull && <span>{t.eventFull}</span>}
                {t.location && <span>{(t.title || t.eventFull) ? ' · ' : ''}{t.location}</span>}
              </div>
              {t.url && <a href={t.url} target="_blank" rel="noopener" class="talk__link">Event details</a>}
            </div>
          </li>
        ))}
      </ol>
      <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.8; margin-top: 2rem;">
        Interested in having SERC speak at your event?
        <a href="/contact" style="color: var(--color-text); text-decoration: underline; text-underline-offset: 3px;">Get in touch</a>.
      </p>
    </div>
    <style>
      .speaking__list { list-style: none; margin: 0; padding: 0; max-width: 820px; }
      .talk {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 2rem;
        padding: 1.5rem 0;
        border-top: 1px solid var(--color-border);
      }
      .talk:last-child { border-bottom: 1px solid var(--color-border); }
      .talk__date {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-faint);
        padding-top: 0.35rem;
      }
      .talk__time { margin-top: 0.35rem; text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--color-text-muted); }
      .talk__pills { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
      .talk__upcoming { border-color: var(--color-text-muted); color: var(--color-text); }
      .talk__title {
        font-family: var(--font-serif);
        font-size: 1.3rem;
        font-weight: 400;
        margin: 0 0 0.3rem;
      }
      .talk__meta { font-size: 14px; color: var(--color-text-muted); line-height: 1.6; }
      .talk__link {
        display: inline-block;
        margin-top: 0.6rem;
        font-size: 13px;
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      @media (max-width: 768px) {
        .talk { grid-template-columns: 1fr; gap: 0.5rem; }
      }
    </style>
  </section>

  <!-- Second image section -->
  <section style="display: grid; grid-template-columns: 1fr 1fr; min-height: 500px; background: var(--color-bg);">
    <div style="overflow: hidden;">
      <img
        src="/images/box-turtle-leaves.jpg"
        alt="Eastern box turtle on leaf litter"
        width="5472"
        height="3648"
        loading="lazy"
        style="width: 100%; height: 100%; object-fit: cover;"
      />
    </div>
    <div style="padding: clamp(3rem, 6vw, 5rem); display: flex; flex-direction: column; justify-content: center; background: var(--color-bg-dark);">
      <h2 style="color: #F5F2EC; margin-bottom: 1.25rem;">Get involved</h2>
      <p style="color: #9A9080; font-size: 1rem; line-height: 1.8; margin-bottom: 2rem;">
        SERC depends on the support of volunteers, donors, and the community.
        Whether you want to volunteer your time, report a found animal, or make
        a donation, we would love to hear from you.
      </p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/contact" class="btn btn--outline" style="border-color: #D5D0C8; color: #D5D0C8;">Contact us</a>
        <a href="/donate" class="btn" style="background: #B5A898; color: #2C2A26;">Donate</a>
      </div>
    </div>
  </section>

  <!-- Ambassadors -->
  <section style="background: var(--color-bg); border-top: 1px solid var(--color-border);">
    <div class="section">
      <h2 style="margin-bottom: 0.5rem;">Meet our ambassadors</h2>
      <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.8; max-width: 600px; margin-bottom: 3rem;">
        Our education ambassadors are animals in our permanent care, unable to survive in the wild
        for various reasons. They represent the species we work to protect and help us connect
        communities to native reptiles and amphibians.
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">

        <div style="background: var(--color-surface); border: 1px solid var(--color-border);">
          <div style="aspect-ratio: 4/3; overflow: hidden;">
            <img src="/images/susie.jpg" alt="Susie the Eastern Box Turtle" width="900" height="720" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="padding: 1.5rem;">
            <div style="font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 0.4rem;">Eastern Box Turtle</div>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: 0.75rem;">Susie</h3>
            <p style="font-size: 15px; color: var(--color-text-muted); line-height: 1.75;">
              Susie is our oldest ambassador at an estimated 17 to 18 years old. She came to us as
              a former pet with shell deformities that make her unsuitable for life in the wild.
              Box turtles have complex needs that are difficult to meet in a home setting, and Susie
              is a wonderful reminder of why wildlife belongs in the wild. She is the inspiration
              behind our AI volunteer assistant, Ask Susie.
            </p>
          </div>
        </div>

        <div style="background: var(--color-surface); border: 1px solid var(--color-border);">
          <div style="aspect-ratio: 4/3; overflow: hidden;">
            <img src="/images/peanut.jpg" alt="Peanut the Eastern Box Turtle" width="900" height="720" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="padding: 1.5rem;">
            <div style="font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 0.4rem;">Eastern Box Turtle</div>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: 0.75rem;">Peanut</h3>
            <p style="font-size: 15px; color: var(--color-text-muted); line-height: 1.75;">
              Peanut is under five years old and came to us as a former pet with metabolic bone
              disease and shell deformities. Having grown up around dogs and cats, he has no
              instinctive fear of predators, a trait that would make him extremely vulnerable in
              the wild. Small but full of personality, Peanut is one of our youngest ambassadors.
            </p>
          </div>
        </div>

        <div style="background: var(--color-surface); border: 1px solid var(--color-border);">
          <div style="aspect-ratio: 4/3; overflow: hidden;">
            <img src="/images/natalie.jpeg" alt="Natalie the Fowler's Toad" width="3024" height="3348" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="padding: 1.5rem;">
            <div style="font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 0.4rem;">Fowler's Toad</div>
            <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin-bottom: 0.75rem;">Natalie</h3>
            <p style="font-size: 15px; color: var(--color-text-muted); line-height: 1.75;">
              Natalie required amputation of her back leg following an animal attack and was deemed
              non-releasable due to the mobility challenges that followed. Her age is unknown, but
              she has settled comfortably into permanent care. Grumpy, chubby, and unapologetically
              herself, Natalie is a favorite.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
