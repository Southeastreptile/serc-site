---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    slug: 'turtle-poaching-and-why-we-keep-locations-vague',
    title: 'Turtle poaching is local: why we keep locations vague',
    date: 'June 22, 2026',
    excerpt: 'A single geotagged photo can lead a poacher straight to a wild turtle — and turtle trafficking is happening right now in Virginia, Maryland, and the Carolinas. Why we blur the details, and how you can share turtles responsibly too.',
    image: '/images/three-toed-box.jpg',
    imageAlt: 'A box turtle in a forest',
    tags: ['turtle poaching', 'wildlife trafficking', 'virginia wildlife'],
  },
  {
    slug: 'ask-serc-building-an-ai-assistant-that-knows-what-it-doesnt-know',
    title: 'Ask Susie: building an AI assistant that knows what it doesn\'t know',
    date: 'May 4, 2026',
    excerpt: 'Wildlife care is not a domain where an AI can afford to make things up. Here\'s why we built a strictly grounded AI assistant for our rehabbers — and how retrieval-augmented generation makes it trustworthy.',
    image: '/images/box-turtle-grass.jpg',
    imageAlt: 'Eastern box turtle in grass',
    tags: ['ai for conservation', 'wildlife rehabilitation', 'conservation tech'],
  },
  {
    slug: 'ai-in-wildlife-rehabilitation-from-paper-notes-to-life-saving-insights',
    title: 'AI in wildlife rehabilitation: from paper notes to life-saving insights',
    date: 'April 13, 2026',
    excerpt: 'How we used Claude, Anthropic\'s AI assistant, to turn handwritten field notes into a working spreadsheet, catch a data entry error, and surface growth insights that were invisible on paper — and why it matters for rehabbers everywhere.',
    image: '/images/hatchling-rock.jpg',
    imageAlt: 'Diamondback terrapin hatchling peeking over a rock',
    tags: ['ai for conservation', 'diamondback terrapins', 'wildlife rehabilitation'],
  },
];
---

<Layout
  title="Reptile & Amphibian Conservation Blog | SERC"
  description="Conservation insights, rehabilitation stories, and technology updates from SERC — a licensed wildlife rehabilitation nonprofit in Virginia."
>

  <div class="blog-list">
    <h1 class="blog-list__heading">Blog</h1>

    {posts.map(post => (
      <a href={`/blog/${post.slug}`} class="post-card">
        <div>
          <div class="post-card__date">{post.date}</div>
          <div class="post-card__title">{post.title}</div>
          <p class="post-card__excerpt">{post.excerpt}</p>
          <div class="tag-list">
            {post.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
          <span class="post-card__read-more">Read more</span>
        </div>
        <div class="post-card__image">
          <img src={post.image} alt={post.imageAlt} />
        </div>
      </a>
    ))}
  </div>

</Layout>
