{
  "hosting": {
    "site": "serc-website-d2ac4",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/(newsletter|subscribe)/?$",
        "destination": "/signup",
        "type": 301
      },
      {
        "regex": "^/chewy/?$",
        "destination": "https://chewpanions.chewy.com/southeastreptile",
        "type": 302
      },
      {
        "regex": "^/venmo/?$",
        "destination": "https://www.venmo.com/u/southeastreptile",
        "type": 302
      },
      {
        "regex": "^/slack/?$",
        "destination": "https://join.slack.com/t/southeastreptile/shared_invite/zt-4ae66cdeb-jW~Rm6Y1kgjqVu5kYCPFqQ",
        "type": 302
      },
      {
        "regex": "^/talks/bsides-2026/?$",
        "destination": "https://docs.google.com/presentation/d/1c4o92Ig1UyRqLvSDO9gf-KOKkpIHYoC-3deD2PC7adA/edit?usp=sharing",
        "type": 302
      },
      {
        "regex": "^/guides/box-turtle-headstart/?$",
        "destination": "https://drive.google.com/file/d/1ZAwaorgIVqJCR710Yso36rfeImbNhnzK/view?usp=drive_link",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=31536000" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=2592000" }
        ]
      }
    ]
  }
}
